{
  "apiVersion": 3,
  "name": "soundbridge/event-grid",
  "title": "Events",
  "category": "soundbridge",
  "icon": "layout",
  "description": "Display upcoming Event posts in a compact news-style list.",
  "supports": {
    "align": [
      "wide",
      "full"
    ],
    "html": false
  },
  "attributes": {
    "eyebrow": {
      "type": "string",
      "default": "News & Events"
    },
    "heading": {
      "type": "string",
      "default": "News about SoundBridge"
    },
    "count": {
      "type": "number",
      "default": 3
    },
    "showButton": {
      "type": "boolean",
      "default": true
    },
    "buttonLabel": {
      "type": "string",
      "default": "See All Events →"
    },
    "buttonUrl": {
      "type": "string",
      "default": "/events"
    }
  },
  "editorScript": "file:./index.js",
  "style": "file:./style-index.css",
  "editorStyle": "file:./index.css",
  "render": "file:./render.php"
}