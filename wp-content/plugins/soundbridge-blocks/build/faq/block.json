{
  "apiVersion": 3,
  "name": "soundbridge/faq",
  "title": "FAQ",
  "category": "soundbridge",
  "icon": "layout",
  "description": "Accordion FAQ section",
  "supports": {
    "align": [
      "wide",
      "full"
    ],
    "html": false,
    "anchor": true
  },
  "attributes": {
    "background": {
      "type": "string",
      "enum": [
        "white",
        "pale-blue",
        "dark-blue"
      ],
      "default": "white"
    },
    "eyebrow": {
      "type": "string",
      "default": "Questions"
    },
    "heading": {
      "type": "string",
      "default": "Frequently asked questions"
    },
    "imageId": {
      "type": "number",
      "default": 0
    },
    "imageUrl": {
      "type": "string",
      "default": ""
    },
    "imageAlt": {
      "type": "string",
      "default": ""
    },
    "showButton": {
      "type": "boolean",
      "default": true
    },
    "buttonLabel": {
      "type": "string",
      "default": "View All FAQs →"
    },
    "buttonUrl": {
      "type": "string",
      "default": "/faq"
    },
    "items": {
      "type": "array",
      "default": [
        {
          "q": "Who can participate?",
          "a": "SoundBridge programs serve young musicians across a range of ages and experience levels."
        },
        {
          "q": "Are scholarships available?",
          "a": "Yes. Need-based support is available for eligible programs."
        }
      ]
    }
  },
  "editorScript": "file:./index.js",
  "style": "file:./style-index.css",
  "editorStyle": "file:./index.css"
}