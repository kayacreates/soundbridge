{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "soundbridge/contact",
  "title": "Contact",
  "category": "soundbridge",
  "icon": "email-alt",
  "description": "Contact form with organization details, response time, and quick links.",
  "supports": {
    "align": [
      "wide",
      "full"
    ],
    "html": false,
    "anchor": true
  },
  "attributes": {
    "background": {
      "type": "string",
      "enum": [
        "white",
        "pale-blue",
        "dark-blue"
      ],
      "default": "white"
    },
    "eyebrow": {
      "type": "string",
      "default": "Send a Message"
    },
    "heading": {
      "type": "string",
      "default": "We're here to help."
    },
    "email": {
      "type": "string",
      "default": "info@saginawbaysoundbridge.com"
    },
    "websiteLabel": {
      "type": "string",
      "default": "saginawbaysoundbridge.com"
    },
    "websiteUrl": {
      "type": "string",
      "default": "https://saginawbaysoundbridge.com"
    },
    "venue": {
      "type": "string",
      "default": "Countryside Trinity Church\n8600 Gratiot Road, Saginaw, MI 48609"
    },
    "responseText": {
      "type": "string",
      "default": "We typically respond within 1 business day."
    },
    "fluentFormId": {
      "type": "integer",
      "default": 0
    },
    "submitLabel": {
      "type": "string",
      "default": "Send Message →"
    },
    "quickLinks": {
      "type": "array",
      "default": [
        {
          "label": "Program Registration",
          "url": "/programs"
        },
        {
          "label": "Scholarship Inquiry",
          "url": "/scholarships"
        },
        {
          "label": "Volunteer Sign-Up",
          "url": "/get-involved"
        },
        {
          "label": "FAQ",
          "url": "/faq"
        }
      ]
    }
  },
  "editorScript": "file:./index.js",
  "style": "file:./style-index.css",
  "editorStyle": "file:./index.css",
  "render": "file:./render.php"
}