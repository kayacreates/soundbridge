{
  "apiVersion": 3,
  "name": "soundbridge/hero",
  "title": "Hero",
  "category": "soundbridge",
  "icon": "layout",
  "description": "Large page or homepage hero with image and CTAs",
  "supports": {
    "align": [
      "wide",
      "full"
    ],
    "html": false,
    "anchor": true
  },
  "attributes": {
    "heroStyle": {
      "type": "string",
      "enum": [
        "home",
        "inner"
      ],
      "default": "inner"
    },
    "showBreadcrumbs": {
      "type": "boolean",
      "default": true
    },
    "breadcrumbHomeLabel": {
      "type": "string",
      "default": "Home"
    },
    "breadcrumbHomeUrl": {
      "type": "string",
      "default": "/"
    },
    "breadcrumbCurrentLabel": {
      "type": "string",
      "default": "Current page"
    },
    "background": {
      "type": "string",
      "enum": [
        "white",
        "pale-blue",
        "dark-blue"
      ],
      "default": "white"
    },
    "eyebrow": {
      "type": "string",
      "default": "Music belongs to everyone."
    },
    "heading": {
      "type": "string",
      "default": "Building community through music."
    },
    "text": {
      "type": "string",
      "default": "Accessible music education for young people across the Saginaw Bay region."
    },
    "showStats": {
      "type": "boolean",
      "default": false
    },
    "stats": {
      "type": "array",
      "default": [
        {
          "value": "99%",
          "label": "Student Satisfaction"
        },
        {
          "value": "1,000+",
          "label": "Community Members"
        },
        {
          "value": "30+",
          "label": "Active Students"
        }
      ]
    },
    "imageId": {
      "type": "number",
      "default": 0
    },
    "imageUrl": {
      "type": "string",
      "default": ""
    },
    "imageAlt": {
      "type": "string",
      "default": ""
    },
    "showRegistration": {
      "type": "boolean",
      "default": false
    },
    "registrationProgramId": {
      "type": "integer",
      "default": 0
    },
    "registrationStatus": {
      "type": "string",
      "default": "Registration Open"
    },
    "registrationTitle": {
      "type": "string",
      "default": "Chamber Music Camp 2026"
    },
    "registrationDetails": {
      "type": "string",
      "default": "June 22–26 · Saginaw, MI"
    },
    "registrationButtonLabel": {
      "type": "string",
      "default": "Register Now"
    },
    "registrationButtonUrl": {
      "type": "string",
      "default": "/programs/chamber-music-camp"
    },
    "showPrimaryButton": {
      "type": "boolean",
      "default": false
    },
    "primaryLabel": {
      "type": "string",
      "default": "Explore Programs"
    },
    "primaryUrl": {
      "type": "string",
      "default": "/programs"
    },
    "showSecondaryButton": {
      "type": "boolean",
      "default": false
    },
    "secondaryLabel": {
      "type": "string",
      "default": "Get Involved"
    },
    "secondaryUrl": {
      "type": "string",
      "default": "/get-involved"
    }
  },
  "editorScript": "file:./index.js",
  "style": "file:./style-index.css",
  "editorStyle": "file:./index.css"
}