{
  "apiVersion": 3,
  "name": "soundbridge/card-grid",
  "title": "Card Grid",
  "category": "soundbridge",
  "icon": "layout",
  "description": "Editable feature card grid",
  "supports": {
    "align": [
      "wide",
      "full"
    ],
    "html": false
  },
  "attributes": {
    "background": {
      "type": "string",
      "enum": [
        "white",
        "pale-blue",
        "dark-blue"
      ],
      "default": "white"
    },
    "mediaStyle": {
      "type": "string",
      "enum": [
        "full",
        "small",
        "none"
      ],
      "default": "full"
    },
    "columns": {
      "type": "number",
      "enum": [
        2,
        3,
        4
      ],
      "default": 3
    },
    "textAlignment": {
      "type": "string",
      "enum": [
        "left",
        "center",
        "right"
      ],
      "default": "left"
    },
    "eyebrow": {
      "type": "string",
      "default": ""
    },
    "heading": {
      "type": "string",
      "default": "How we help"
    },
    "intro": {
      "type": "string",
      "default": ""
    },
    "cards": {
      "type": "array",
      "default": [
        {
          "iconId": 0,
          "iconUrl": "",
          "iconAlt": "",
          "title": "Accessible Programs",
          "text": "Welcoming music education for students at every stage."
        },
        {
          "iconId": 0,
          "iconUrl": "",
          "iconAlt": "",
          "title": "Community Connection",
          "text": "Creating relationships through shared music-making."
        },
        {
          "iconId": 0,
          "iconUrl": "",
          "iconAlt": "",
          "title": "Student Growth",
          "text": "Building confidence, musicianship, and belonging."
        }
      ]
    }
  },
  "editorScript": "file:./index.js",
  "style": "file:./style-index.css",
  "editorStyle": "file:./index.css"
}