{
  "apiVersion": 3,
  "name": "soundbridge/cta",
  "title": "Call to Action",
  "category": "soundbridge",
  "icon": "layout",
  "description": "Full-width CTA section",
  "supports": {
    "align": [
      "wide",
      "full"
    ],
    "html": false,
    "anchor": true
  },
  "attributes": {
    "background": {
      "type": "string",
      "enum": [
        "white",
        "pale-blue",
        "blue"
      ],
      "default": "blue"
    },
    "showButton": {
      "type": "boolean",
      "default": true
    },
    "heading": {
      "type": "string",
      "default": "Ready to make music with us?"
    },
    "text": {
      "type": "string",
      "default": "Find a program, volunteer, donate, or simply come to a concert."
    },
    "buttonLabel": {
      "type": "string",
      "default": "Get Involved"
    },
    "buttonUrl": {
      "type": "string",
      "default": "/get-involved"
    },
    "showSecondaryButton": {
      "type": "boolean",
      "default": false
    },
    "secondaryButtonLabel": {
      "type": "string",
      "default": "Learn More"
    },
    "secondaryButtonUrl": {
      "type": "string",
      "default": "/about"
    }
  },
  "editorScript": "file:./index.js",
  "style": "file:./style-index.css"
}