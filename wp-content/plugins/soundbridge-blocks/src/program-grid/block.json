{
  "apiVersion": 3,
  "name": "soundbridge/program-grid",
  "title": "Program Grid",
  "category": "soundbridge",
  "icon": "layout",
  "description": "Dynamic grid of Program posts",
  "supports": {
    "align": [
      "wide",
      "full"
    ],
    "html": false,
    "anchor": true
  },
  "attributes": {
    "background": { "type": "string", "enum": ["white", "pale-blue", "dark-blue"], "default": "pale-blue" },
    "eyebrow": {
      "type": "string",
      "default": "Our Programs"
    },
    "heading": {
      "type": "string",
      "default": "Find a Program That Fits Your Musician"
    },
    "showViewAll": {
      "type": "boolean",
      "default": true
    },
    "viewAllLabel": {
      "type": "string",
      "default": "View All Programs →"
    },
    "viewAllUrl": {
      "type": "string",
      "default": "/programs"
    },
    "editorPreview": {
      "type": "boolean",
      "default": false
    },
    "count": {
      "type": "number",
      "default": 6
    },
    "includeChildPrograms": {
      "type": "boolean",
      "default": false
    }
  },
  "editorScript": "file:./index.js",
  "style": "file:./style-index.css",
  "editorStyle": "file:./index.css",
  "render": "file:./render.php"
}
